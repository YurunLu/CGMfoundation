{
  "dataset": "zhao",
  "dataset_variant": "no_t1d",
  "sample_filters": [
    {
      "column": "type",
      "exclude_values": ["T1D"]
    }
  ],
  "targets": [
    "reg:hba1c",
    "reg:age",
    "reg:ht",
    "reg:wt",
    "reg:bmi",
    "reg:fpg",
    "reg:pg120",
    "reg:cp0",
    "reg:cp120",
    "reg:ins0",
    "reg:ins120",
    "reg:ga",
    "reg:tc",
    "reg:tg",
    "reg:hdl",
    "reg:ldl",
    "reg:cr",
    "reg:ua",
    "reg:bu",
    "reg:duration",
    "cls:gender",
    "cls:Macrovascular",
    "cls:Microvascular",
    "cls:Complication"
  ],
  "feature": {
    "feature_set": "iglu",
    "freq_minutes": 5,
    "glucose_unit": "auto"
  },
  "split": {
    "n_splits": 5,
    "seed": 42,
    "min_samples": 30
  },
  "training": {
    "device": "cuda:0",
    "devices": ["cuda:0", "cuda:1"],
    "out_root": "../../outputs/gmi_iglu_lab_ridge",
    "save_fold_predictions": true,
    "wait_for_idle_gpus": true,
    "idle_min_memory_gb": 8.0,
    "idle_max_utilization": 30.0,
    "idle_poll_seconds": 60.0
  },
  "ridge": {
    "alpha_values": [0.001, 0.01, 0.1, 1.0, 10.0, 100.0, 1000.0, 10000.0]
  }
}
