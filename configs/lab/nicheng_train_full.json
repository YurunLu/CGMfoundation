{
    "dataset": "nicheng",
    "targets": [
        "reg:bmi",
        "reg:hba1c",
        "reg:ldl-ch",
        "reg:hdl-ch",
        "reg:pg120",
        "reg:pg60",
        "reg:fpg",
        "reg:ins120",
        "reg:ins0",
        "reg:Age",
        {
            "target": "Type",
            "mode": "cls",
            "task_name": "cls_binary_ND_DM",
            "include_values": [
                "NGT",
                "PreDM",
                "DM",
                "T1D",
                "T2D",
                "T2DM",
                "SpecialDM"
            ],
            "label_mapping": {
                "NGT": 0,
                "PreDM": 0,
                "DM": 1,
                "T1D": 1,
                "T2D": 1,
                "T2DM": 1,
                "SpecialDM": 1
            }
        },
        {
            "target": "Type",
            "mode": "cls",
            "task_name": "cls_ternary_NGT_PreDM_T2D",
            "include_values": ["NGT", "PreDM", "T2D", "T2DM"],
            "label_mapping": {
                "NGT": 0,
                "PreDM": 1,
                "T2D": 2,
                "T2DM": 2
            }
        }
    ],
    "pretrain": {
        "ckpt_path": "/workspace/last/best_forecast_20260420_105114_dim256_patch144_stride3.pt",
        "model_name": "CGMfoundation_lab_nicheng"
    },
    "split": {
        "n_splits": 5,
        "seed": 42,
        "min_samples": 30,
        "split_root": "../../data_lab/lab_target_cv"
    },
    "training": {
        "device": "cuda:0",
        "devices": ["cuda:0", "cuda:1"],
        "epochs": 200,
        "batch_size": 128,
        "num_workers": 4,
        "lr": 0.0001,
        "weight_decay": 0.01,
        "layer_decay": 0.7,
        "freeze_base": true,
        "unfreeze_after": 50,
        "patience": 30,
        "out_root": "../../outputs/CGMfoundation_lab",
        "disable_compile": false,
        "wait_for_idle_gpus": true,
        "idle_min_memory_gb": 8.0,
        "idle_max_utilization": 30.0,
        "idle_poll_seconds": 60.0
    },
    "model": {
        "dropout": 0.3
    }
}
